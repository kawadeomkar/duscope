# Generated by the harness (bench/README.md): the trees and their stamps, the
# harness-local tool installs, and hyperfine's per-round exports.
/.trees/
/.tools/
/.runs/

# Result files of routine runs (<date>-<platform>.json) stay out of main: the
# nightly job pushes them to the bench-results branch. Results a package means
# to commit (thread-sweep-*.json, results/1.0/) have other names.
/results/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.json
/results/*.tmp

__pycache__/
