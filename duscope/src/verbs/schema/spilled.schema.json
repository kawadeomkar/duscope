{
  "$defs": {
    "Spill": {
      "description": "An envelope written to a file.",
      "properties": {
        "bytes": {
          "description": "The file's size.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "The file, absolute.",
          "type": "string"
        },
        "rows": {
          "description": "The envelope's rows (`returned_count`).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "rows",
        "bytes"
      ],
      "type": "object"
    },
    "Tool": {
      "description": "The program that wrote an envelope.",
      "properties": {
        "name": {
          "const": "duscope",
          "description": "Always `duscope`.",
          "type": "string"
        },
        "version": {
          "description": "The release, as `duscope --version` prints it.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "Warning": {
      "description": "A warning.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "partial_read",
                "mounts_excluded",
                "stale_index",
                "scan_age",
                "atime_unreliable",
                "attrs_not_collected",
                "dataless_present",
                "full_disk_access_missing",
                "clones_unavailable",
                "upper_bound",
                "vanished",
                "index_untouched",
                "spilled",
                "deprecated_flag",
                "tz_unavailable"
              ]
            },
            {
              "type": "string"
            }
          ],
          "description": "One of the conventions' warning codes.",
          "type": "string"
        },
        "count": {
          "description": "How many things it is about, where that applies.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "hint": {
          "description": "One imperative sentence naming a command.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "One sentence.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "count",
        "hint"
      ],
      "type": "object"
    }
  },
  "$id": "spilled.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What stdout gets in place of an envelope longer than `--max-chars`: the\nfile the whole envelope went to, and its first rows.",
  "properties": {
    "ok": {
      "description": "Whether the command succeeded.",
      "type": "boolean"
    },
    "preview": {
      "description": "The envelope's first rows, at most five.",
      "items": true,
      "type": "array"
    },
    "schema_version": {
      "description": "The version of the envelope's shape.",
      "type": "string"
    },
    "spilled": {
      "$ref": "#/$defs/Spill",
      "description": "Where the envelope went."
    },
    "tool": {
      "$ref": "#/$defs/Tool",
      "description": "The program."
    },
    "warnings": {
      "description": "The envelope's warnings, and `spilled`.",
      "items": {
        "$ref": "#/$defs/Warning"
      },
      "type": "array"
    }
  },
  "required": [
    "ok",
    "schema_version",
    "tool",
    "spilled",
    "preview",
    "warnings"
  ],
  "title": "SpilledEnvelope",
  "type": "object",
  "x-since": "0.2"
}
