{"jsonrpc":"2.0","id":1,"result":{"tools":[{"name":"duscope_by_type","description":"The bytes under a path in a saved scan by kind of file (video, archives, code, …), largest first, with each kind's largest files.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"duscope_by_type.input.json","title":"duscope_by_type","description":"The arguments of duscope_by_type, which runs `duscope by-type --no-scan`.","type":"object","properties":{"scan_id":{"type":"string","description":"The saved scan to read: an id duscope_scan or duscope_scans gave (its first 4 or more characters will do), or latest. Default: the newest saved scan that holds the path and was taken with the default options"},"path":{"type":"string","description":"A directory or file under one of the server's roots: absolute, or relative to the scan's root. Default: the scan's root, or the server's root when it has one"},"examples":{"type":"integer","minimum":0,"maximum":100,"description":"The largest files listed for each kind. Default: 3"},"glob":{"type":"array","items":{"type":"string"},"description":"Only rows whose path matches one of these globs"},"exclude":{"type":"array","items":{"type":"string"},"description":"Leave out rows whose path matches one of these globs"},"size":{"type":"string","enum":["allocated","apparent"],"description":"What rows are ranked and shown by: bytes on disk (allocated, the default) or apparent length"},"fields":{"type":"array","items":{"type":"string","pattern":"^[a-z_]+$"},"description":"The fields of each row, in this order. Default: every field"},"limit":{"type":"integer","minimum":1,"maximum":100,"description":"Rows to return. Default: 25"}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"anthropic/maxResultSizeChars":24000}},{"name":"duscope_scan","description":"Scan a directory under the roots and save the scan: its scan_id, totals and largest directories. The other tools read saved scans, so call this first; with max_age, a recent scan of the directory is returned instead of scanning again.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"duscope_scan.input.json","title":"duscope_scan","description":"The arguments of duscope_scan, which runs `duscope scan --save`.","type":"object","properties":{"root":{"type":"string","description":"The directory to scan: absolute, under one of the server's roots. Default: the server's root when it has one"},"attrs":{"type":"string","enum":["basic","full"],"description":"The attributes to collect: full adds access and birth times, mode, owner and group, which duscope_stale's atime reads. Default: basic"},"clones":{"type":"boolean","description":"Count APFS clones once (true, the default) or every clone in full (false)"},"one_file_system":{"type":"boolean","description":"Stay on the root's filesystem. Default: false"},"max_age":{"type":"string","description":"Return a saved scan of the root taken with these options and younger than this, a number with h, d, w or y (1h), instead of scanning again. Default: always scan"}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"anthropic/maxResultSizeChars":24000}},{"name":"duscope_scans","description":"The saved scans of directories under the roots, newest first: each one's scan_id, root, times, attributes, entry count and totals.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"duscope_scans.input.json","title":"duscope_scans","description":"The arguments of duscope_scans, which runs `duscope scans` on the server's roots: none.","type":"object","properties":{},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"anthropic/maxResultSizeChars":24000}},{"name":"duscope_stale","description":"Large files under a path in a saved scan left unmodified for a long time (by default 10 MB and 180 days), largest first; paged with cursor.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"duscope_stale.input.json","title":"duscope_stale","description":"The arguments of duscope_stale, which runs `duscope stale --no-scan`.","type":"object","properties":{"scan_id":{"type":"string","description":"The saved scan to read: an id duscope_scan or duscope_scans gave (its first 4 or more characters will do), or latest. Default: the newest saved scan that holds the path and was taken with the default options"},"path":{"type":"string","description":"A directory or file under one of the server's roots: absolute, or relative to the scan's root. Default: the scan's root, or the server's root when it has one"},"older_than":{"type":"string","description":"Files left unmodified for at least this long: a number with h, d, w or y. Default: 180d"},"min_size":{"type":"string","description":"Files at least this large: 100M, 1.5G, 10KB, or a number of bytes. Default: 10M"},"atime":{"type":"boolean","description":"Also require the access time to be that old, which a scan taken with attrs full holds. Default: false"},"glob":{"type":"array","items":{"type":"string"},"description":"Only rows whose path matches one of these globs"},"exclude":{"type":"array","items":{"type":"string"},"description":"Leave out rows whose path matches one of these globs"},"size":{"type":"string","enum":["allocated","apparent"],"description":"What rows are ranked and shown by: bytes on disk (allocated, the default) or apparent length"},"fields":{"type":"array","items":{"type":"string","pattern":"^[a-z_]+$"},"description":"The fields of each row, in this order. Default: every field"},"limit":{"type":"integer","minimum":1,"maximum":100,"description":"Rows to return. Default: 25"},"cursor":{"type":"string","description":"Where the next page starts: the previous result's next_cursor, sent with the same other arguments"}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"anthropic/maxResultSizeChars":24000}},{"name":"duscope_summary","description":"Totals under a path in a saved scan: bytes on disk and apparent, files, directories, errors, the volumes, and the bytes no entry accounts for.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"duscope_summary.input.json","title":"duscope_summary","description":"The arguments of duscope_summary, which runs `duscope summary --no-scan`.","type":"object","properties":{"scan_id":{"type":"string","description":"The saved scan to read: an id duscope_scan or duscope_scans gave (its first 4 or more characters will do), or latest. Default: the newest saved scan that holds the path and was taken with the default options"},"path":{"type":"string","description":"A directory or file under one of the server's roots: absolute, or relative to the scan's root. Default: the scan's root, or the server's root when it has one"}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"anthropic/maxResultSizeChars":24000}},{"name":"duscope_top","description":"The largest directories, or files, under a path in a saved scan, largest first; narrowed by depth, size and glob, and paged with cursor.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"duscope_top.input.json","title":"duscope_top","description":"The arguments of duscope_top, which runs `duscope top --no-scan`.","type":"object","properties":{"scan_id":{"type":"string","description":"The saved scan to read: an id duscope_scan or duscope_scans gave (its first 4 or more characters will do), or latest. Default: the newest saved scan that holds the path and was taken with the default options"},"path":{"type":"string","description":"A directory or file under one of the server's roots: absolute, or relative to the scan's root. Default: the scan's root, or the server's root when it has one"},"files":{"type":"boolean","description":"List the largest files instead of directories. Default: false"},"depth":{"type":"integer","minimum":0,"description":"How many levels below the path to list. Default: 1 for directories, every level for files"},"min_size":{"type":"string","description":"Leave out rows smaller than this: 100M, 1.5G, 10KB, or a number of bytes"},"glob":{"type":"array","items":{"type":"string"},"description":"Only rows whose path matches one of these globs"},"exclude":{"type":"array","items":{"type":"string"},"description":"Leave out rows whose path matches one of these globs"},"size":{"type":"string","enum":["allocated","apparent"],"description":"What rows are ranked and shown by: bytes on disk (allocated, the default) or apparent length"},"fields":{"type":"array","items":{"type":"string","pattern":"^[a-z_]+$"},"description":"The fields of each row, in this order. Default: every field"},"limit":{"type":"integer","minimum":1,"maximum":100,"description":"Rows to return. Default: 25"},"cursor":{"type":"string","description":"Where the next page starts: the previous result's next_cursor, sent with the same other arguments"}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"anthropic/maxResultSizeChars":24000}},{"name":"test_summary","description":"A saved scan's totals under a path (a test fixture).","inputSchema":{"type":"object","properties":{"path":{"type":"string","description":"A path under a root"},"scan_id":{"type":"string","description":"latest, or a saved scan's id"}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"anthropic/maxResultSizeChars":24000}},{"name":"test_top","description":"The largest directories under a path (a test fixture).","inputSchema":{"type":"object","properties":{"path":{"type":"string"},"limit":{"type":"integer","minimum":1,"maximum":100}},"required":["path"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"anthropic/maxResultSizeChars":24000}}],"ttlMs":3600000,"cacheScope":"public","resultType":"complete","_meta":{"io.modelcontextprotocol/serverInfo":{"name":"duscope","version":"<version>"}}}}
